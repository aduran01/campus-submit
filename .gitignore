# Dependencies
node_modules

# Build output
dist
dist-ssr
build

# Environment files. .env.production only holds the public API URL (no
# secrets) and is intentionally committed so the GitHub Actions build picks
# it up automatically — everything else here can hold real secrets locally
# (see server/.env) and must never be committed.
.env
.env.*.local
.env.development.local
!.env.example
!.env.production

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite / TS cache
*.tsbuildinfo
.vite
