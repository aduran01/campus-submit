# Copy this file to .env and fill in real values for local development.
# In production (Render), set these as environment variables in the
# service's dashboard instead of committing a .env file.

# Postgres connection string, e.g. from Render's Postgres dashboard
# ("External Database URL" for local dev, "Internal Database URL" once
# both the API and the database live on Render).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — used to sign session tokens (JWT). Generate one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Plaintext passwords for the two seeded demo accounts (admin / student).
# Read once at boot and immediately bcrypt-hashed (server/src/db.ts) — only
# the hash is ever written to the database. Pick your own values for local
# dev; in production these are set only in Render's dashboard, never
# committed. Changing STUDENT_SEED_PASSWORD takes effect on the next boot
# (the student row is re-synced every boot); changing ADMIN_SEED_PASSWORD
# only affects a brand-new database — an already-seeded admin row must be
# updated directly (see README's "To change a password").
ADMIN_SEED_PASSWORD=change-me
STUDENT_SEED_PASSWORD=change-me

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://aduran01.github.io

PORT=4000
